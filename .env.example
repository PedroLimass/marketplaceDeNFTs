# URL base da API REST. Com mocks ativos, o MSW intercepta este prefixo.
VITE_API_BASE_URL=/api

# Origem do servidor Socket.IO.
VITE_SOCKET_URL=/

# Ativa a camada de mocks (MSW). Também deve estar ativa no build de demonstração.
VITE_ENABLE_MOCKS=true

# Cenário inicial dos mocks. Pode ser sobrescrito com ?scenario=<id> na URL.
# Valores: default, empty, slow-network, out-of-order, flaky, offline,
# server-error, timeout, expired-session, unauthorized, signup-conflict,
# invalid-coupon, checkout-price-change, checkout-sold-out, order-timeout,
# payment-rejected, wallet-refused
VITE_MOCK_SCENARIO=default
